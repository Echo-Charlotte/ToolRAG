# ===== 应用 =====
APP_NAME=ToolRAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== LLM（对话模型，M3 使用；默认硅基流动，OpenAI 兼容接口）=====
# 留空则复用下面的 EMBEDDING_API_KEY（同一个硅基流动账号，推荐）
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ===== Embedding（硅基流动，OpenAI 兼容接口）=====
# 注册地址：https://cloud.siliconflow.cn/  →  API 密钥
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ===== RAG 检索参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# ===== 混合检索（M2）=====
SEARCH_MODE=hybrid
FUSION_STRATEGY=rrf
RRF_K=60
HYBRID_ALPHA=0.5
CANDIDATE_MULTIPLIER=4

# ===== Agent（M3）=====
AGENT_MAX_ROUNDS=5
AGENT_TEMPERATURE=0.0

# ===== PostgreSQL + PGVector =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=toolrag
POSTGRES_PASSWORD=toolrag
POSTGRES_DB=toolrag

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== 缓存（M6）=====
# 检索结果缓存；Redis 不可用时自动降级（不影响检索本身）
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_TIMEOUT=0.5
CACHE_KEY_PREFIX=toolrag
