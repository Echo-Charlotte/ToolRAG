# ===== 应用 =====
APP_NAME=ToolRAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== LLM（对话模型，M3 使用）=====
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# ===== Embedding（硅基流动，OpenAI 兼容接口）=====
# 注册地址：https://cloud.siliconflow.cn/  →  API 密钥
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ===== RAG 检索参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

# ===== PostgreSQL + PGVector =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=toolrag
POSTGRES_PASSWORD=toolrag
POSTGRES_DB=toolrag

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
