# ===== 应用 =====
APP_NAME=ToolRAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== LLM =====
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ===== PostgreSQL + PGVector =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=toolrag
POSTGRES_PASSWORD=toolrag
POSTGRES_DB=toolrag

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
